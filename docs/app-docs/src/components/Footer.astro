---
import logoWhite from "@/assets/logo-white.svg";
import logoBlack from "@/assets/logo-black.svg";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-shell footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand" aria-label="Sylve home">
        <img src={logoBlack.src} alt="" class="dark:hidden" />
        <img src={logoWhite.src} alt="" class="hidden dark:block" />
        <span>SYLVE</span>
      </a>
      <p>Open-source infrastructure management, native to FreeBSD.</p>
    </div>

    <nav aria-label="Product links">
      <p>Product</p>
      <a href="/#capabilities">Capabilities</a>
      <a href="/getting-started/" data-astro-reload>Get started</a>
      <a href="/blog">Blog</a>
    </nav>

    <nav aria-label="Resource links">
      <p>Resources</p>
      <a href="/docs/" data-astro-reload>Documentation</a>
      <a href="https://github.com/AlchemillaHQ/Sylve">GitHub</a>
      <a href="https://discord.gg/bJB826JvXK">Discord</a>
    </nav>

    <nav aria-label="Contact links">
      <p>Contact</p>
      <a href="mailto:hello@sylve.io">hello@sylve.io</a>
      <button type="button" data-sponsor-open>Sponsor Sylve</button>
    </nav>
  </div>
  <div class="site-shell footer-bottom">
    <span>© {currentYear} Sylve</span>
    <span>BSD-2-Clause</span>
    <span class="footer-made">
      Made with <span class="icon-[mdi--heart] size-3.5" role="img" aria-label="love"></span> in
      <span role="img" aria-label="India">🇮🇳</span>
    </span>
  </div>
</footer>
