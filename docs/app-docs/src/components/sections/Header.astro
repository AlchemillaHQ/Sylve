---
import MobileSheet from "@/components/MobileSheet.svelte";
import logoWhite from "@/assets/logo-white.svg";
import logoBlack from "@/assets/logo-black.svg";
---

<header class="site-header">
  <nav class="site-shell site-nav" aria-label="Primary navigation">
    <a href="/" class="brand" aria-label="Sylve home">
      <img src={logoBlack.src} alt="" class="dark:hidden" />
      <img src={logoWhite.src} alt="" class="hidden dark:block" />
      <span>SYLVE</span>
    </a>

    <div class="site-nav-links">
      <a href="/#capabilities">Product</a>
      <a href="/docs/" data-astro-reload>Documentation</a>
      <a href="/blog">Blog</a>
      <a
        href="https://github.com/AlchemillaHQ/Sylve"
        target="_blank"
        rel="noopener noreferrer"
      >GitHub</a>
    </div>

    <div class="site-nav-actions">
      <button type="button" class="nav-sponsor" data-sponsor-open>
        Sponsor
        <span class="icon-[lucide--heart-handshake] size-3.5" aria-hidden="true"></span>
      </button>
      <button
        type="button"
        data-theme-toggle
        class="theme-toggle"
        aria-label="Toggle color mode"
        title="Toggle color mode"
      >
        <span class="icon-[lucide--sun] size-4 dark:hidden"></span>
        <span class="icon-[lucide--moon] hidden size-4 dark:block"></span>
      </button>
    </div>

    <MobileSheet client:load />
  </nav>
</header>
