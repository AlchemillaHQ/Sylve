---
const sponsors = [
  { name: "Alchemilla", href: "https://alchemilla.io", lightLogo: "/sponsors/Alchemilla-Dark.webp", darkLogo: "/sponsors/Alchemilla-White.webp" },
  { name: "FreeBSD Foundation", href: "https://freebsdfoundation.org", lightLogo: "/sponsors/FreeBSD-Red.webp", darkLogo: "/sponsors/FreeBSD-White.webp" },
  { name: "IP Technics", href: "https://iptechnics.com", lightLogo: "/sponsors/IP-Technics-Dark.webp", darkLogo: "/sponsors/IP-Technics-White.webp" },
];
---

<section class="supporters site-shell" aria-labelledby="supporters-title">
  <div class="supporters-panel">
    <div class="supporters-copy">
      <p class="section-kicker">Project supporters</p>
      <h2 id="supporters-title">Made possible by open infrastructure partners</h2>
      <p>
        Organizations helping Sylve stay open, independent, and useful on real
        infrastructure.
      </p>
      <a href="https://github.com/sponsors/AlchemillaHQ" target="_blank" rel="noopener noreferrer">
        Sponsor Sylve <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="supporter-logos">
      {sponsors.map((sponsor) => (
        <a href={sponsor.href} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${sponsor.name}`}>
          <img src={sponsor.lightLogo} alt={`${sponsor.name} logo`} class="dark:hidden" loading="lazy" decoding="async" />
          <img src={sponsor.darkLogo} alt={`${sponsor.name} logo`} class="hidden dark:block" loading="lazy" decoding="async" />
        </a>
      ))}
      <a
        class="supporter-placeholder"
        href="https://github.com/sponsors/AlchemillaHQ"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Sponsor Sylve and add your logo"
      >
        <span aria-hidden="true">+</span>
        <strong>Your logo here</strong>
        <small>Become a supporter ↗</small>
      </a>
    </div>
  </div>
</section>
