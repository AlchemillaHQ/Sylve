---
import CopyButton from "@/components/CopyButton.svelte";
import HeroBenefits from "@/components/HeroBenefits.svelte";
import ProductDemo from "@/components/ProductDemo.svelte";
---

<section class="site-shell hero">
  <div class="hero-copy">
    <h1>
      <span>Strong Foundation.</span>
      <span>Simple Control.</span>
    </h1>
    <p class="hero-summary">
      Control your infrastructure without getting buried in management tools.
    </p>

    <div class="install-command" aria-label="Install Sylve on FreeBSD with pkg">
      <span class="install-label">Quick install</span>
      <span class="install-prompt" aria-hidden="true">$</span>
      <code>pkg install sylve</code>
      <CopyButton client:load text="pkg install sylve" />
    </div>

    <div class="hero-actions">
      <a href="/docs/" class="button button-primary">
        Read the docs
        <span class="icon-[lucide--arrow-up-right] size-4" aria-hidden="true"></span>
      </a>
      <a
        href="https://github.com/AlchemillaHQ/Sylve"
        target="_blank"
        rel="noopener noreferrer"
        class="button button-secondary"
      >
        View on GitHub
      </a>
    </div>
  </div>

  <div class="hero-benefits">
    <HeroBenefits client:load />
  </div>

  <div class="hero-demo">
    <ProductDemo client:load />
  </div>
</section>
