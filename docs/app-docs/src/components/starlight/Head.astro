---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { ClientRouter } from "astro:transitions";

const ogImage = new URL("/og-default.png", Astro.site ?? Astro.url).toString();
---

<style is:inline>
  html[data-starlight-loading] body {
    visibility: hidden;
  }
</style>
<script is:inline>
  (() => {
    const root = document.documentElement;
    root.dataset.starlightLoading = "";
    let revealFallback;

    const reveal = () => {
      window.clearTimeout(revealFallback);
      requestAnimationFrame(() => {
        root.removeAttribute("data-starlight-loading");
      });
    };

    const revealWhenStyled = () => {
      const pendingStylesheets = Array.from(
        document.querySelectorAll('link[rel="stylesheet"]'),
      ).filter(
        (link) =>
          (!link.media || window.matchMedia(link.media).matches) && !link.sheet,
      );

      if (pendingStylesheets.length === 0) {
        reveal();
        return;
      }

      Promise.all(
        pendingStylesheets.map(
          (link) =>
            new Promise((resolve) => {
              link.addEventListener("load", resolve, { once: true });
              link.addEventListener("error", resolve, { once: true });
            }),
        ),
      ).then(reveal);
    };

    revealFallback = window.setTimeout(reveal, 5000);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", revealWhenStyled, { once: true });
    } else {
      revealWhenStyled();
    }

    const stored = localStorage.getItem("starlight-theme") || localStorage.getItem("sylve_theme");
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const theme = stored === "light" ? "light" : stored === "dark" ? "dark" : prefersDark ? "dark" : "light";
    root.style.setProperty("background-color", theme === "dark" ? "#0f0f0f" : "#fff");
  })();
</script>
<script is:inline>
  (() => {
    if (window.__sylveSidebarScrollPersistence) return;
    window.__sylveSidebarScrollPersistence = true;

    const restoreSidebarContext = () => {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          const scroller = document.getElementById("starlight__sidebar");
          const sidebar = scroller?.querySelector("sl-sidebar-state-persist");
          if (!scroller || !sidebar) return;

          try {
            const parsed = JSON.parse(
              sessionStorage.getItem("sl-sidebar-state") || "{}",
            );
            const stored =
              parsed && typeof parsed === "object" ? parsed : {};

            if (
              stored.hash === sidebar.dataset.hash &&
              typeof stored.scroll === "number"
            ) {
              scroller.scrollTop = stored.scroll;
            }

            const normalizePath = (value) => {
              const pathname = new URL(value, window.location.href).pathname;
              return pathname === "/" ? pathname : pathname.replace(/\/+$/, "");
            };
            const currentPath = normalizePath(window.location.href);
            const activeLink =
              scroller.querySelector('a[aria-current="page"]') ||
              Array.from(scroller.querySelectorAll("a[href]")).find(
                (link) => normalizePath(link.href) === currentPath,
              );

            if (!(activeLink instanceof HTMLElement)) return;

            const open =
              stored.hash === sidebar.dataset.hash && Array.isArray(stored.open)
                ? [...stored.open]
                : [];
            let parent = activeLink.parentElement;

            while (parent && parent !== scroller) {
              if (parent instanceof HTMLDetailsElement) {
                parent.open = true;
                const restorePoint = parent.querySelector(
                  ":scope > sl-sidebar-restore[data-index]",
                );
                const index = Number.parseInt(
                  restorePoint?.dataset.index || "",
                  10,
                );
                if (!Number.isNaN(index)) open[index] = true;
              }
              parent = parent.parentElement;
            }

            const scrollerRect = scroller.getBoundingClientRect();
            const activeRect = activeLink.getBoundingClientRect();
            const viewportPadding = 24;
            const activeIsVisible =
              activeRect.top >= scrollerRect.top + viewportPadding &&
              activeRect.bottom <= scrollerRect.bottom - viewportPadding;

            if (!activeIsVisible && activeRect.height > 0) {
              const centeredScrollTop =
                scroller.scrollTop +
                activeRect.top -
                scrollerRect.top -
                (scroller.clientHeight - activeRect.height) / 2;
              scroller.scrollTop = Math.max(
                0,
                Math.min(
                  centeredScrollTop,
                  scroller.scrollHeight - scroller.clientHeight,
                ),
              );
            }

            sessionStorage.setItem(
              "sl-sidebar-state",
              JSON.stringify({
                hash: sidebar.dataset.hash || "",
                open,
                scroll: scroller.scrollTop,
              }),
            );
          } catch {}
        });
      });
    };

    document.addEventListener("astro:page-load", restoreSidebarContext);

    document.addEventListener(
      "click",
      (event) => {
        if (!(event.target instanceof Element)) return;
        if (!event.target.closest("#starlight__sidebar a[href]")) return;

        const scroller = document.getElementById("starlight__sidebar");
        const sidebar = scroller?.querySelector("sl-sidebar-state-persist");
        if (!scroller || !sidebar) return;

        try {
          const stored = JSON.parse(
            sessionStorage.getItem("sl-sidebar-state") || "{}",
          );
          sessionStorage.setItem(
            "sl-sidebar-state",
            JSON.stringify({
              hash: sidebar.dataset.hash || "",
              open:
                stored.hash === sidebar.dataset.hash && Array.isArray(stored.open)
                  ? stored.open
                  : [],
              scroll: scroller.scrollTop,
            }),
          );
        } catch {}
      },
      { capture: true },
    );
  })();
</script>
<script is:inline>
  (() => {
    const viewerId = "sylve-doc-image-viewer";

    const bindImages = () => {
      document
        .querySelectorAll(".sl-markdown-content img:not([data-doc-image-viewer])")
        .forEach((image) => {
          if (image.closest("a")) return;

          image.dataset.docImageViewer = "";
          image.tabIndex = 0;
          image.setAttribute("role", "button");
          image.setAttribute("aria-label", `Expand image: ${image.alt || "documentation image"}`);
          image.title = "Click to expand";
          image.addEventListener("click", () => openViewer(image));
          image.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              openViewer(image);
            }
          });
        });
    };

    const getViewer = () => {
      let dialog = document.getElementById(viewerId);
      if (dialog) return dialog;

      dialog = document.createElement("dialog");
      dialog.id = viewerId;
      dialog.className = "docs-image-viewer";
      dialog.innerHTML = `
        <div class="docs-image-viewer-bar">
          <p class="docs-image-viewer-label">Image viewer</p>
          <div class="docs-image-viewer-actions">
            <button type="button" data-doc-image-action="out" aria-label="Zoom out">−</button>
            <button type="button" data-doc-image-action="reset" aria-label="Reset zoom">100%</button>
            <button type="button" data-doc-image-action="in" aria-label="Zoom in">+</button>
            <button type="button" data-doc-image-action="close" aria-label="Close image viewer">Close</button>
          </div>
        </div>
        <div class="docs-image-viewer-stage">
          <img alt="" />
        </div>
      `;

      let zoom = 1;
      let offsetX = 0;
      let offsetY = 0;
      let dragStartX = 0;
      let dragStartY = 0;
      let dragging = false;
      const image = dialog.querySelector("img");
      const stage = dialog.querySelector(".docs-image-viewer-stage");
      const updateZoom = () => {
        image.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${zoom})`;
        dialog.querySelector('[data-doc-image-action="reset"]').textContent = `${Math.round(zoom * 100)}%`;
      };
      const resetZoom = () => {
        zoom = 1;
        offsetX = 0;
        offsetY = 0;
        updateZoom();
      };

      dialog.querySelector(".docs-image-viewer-actions").addEventListener("click", (event) => {
        const action = event.target.closest("button")?.dataset.docImageAction;
        if (action === "in") zoom = Math.min(zoom + 0.25, 3);
        if (action === "out") zoom = Math.max(zoom - 0.25, 0.5);
        if (action === "reset") resetZoom();
        if (action === "close") dialog.close();
        if (action === "in" || action === "out") updateZoom();
      });
      stage.addEventListener("wheel", (event) => {
        event.preventDefault();
        zoom = Math.min(3, Math.max(0.5, zoom + (event.deltaY < 0 ? 0.15 : -0.15)));
        updateZoom();
      }, { passive: false });
      stage.addEventListener("pointerdown", (event) => {
        if (event.target !== image || event.button !== 0) return;

        dragging = true;
        dragStartX = event.clientX - offsetX;
        dragStartY = event.clientY - offsetY;
        stage.setPointerCapture(event.pointerId);
        stage.classList.add("is-dragging");
        event.preventDefault();
      });
      stage.addEventListener("pointermove", (event) => {
        if (!dragging) return;

        offsetX = event.clientX - dragStartX;
        offsetY = event.clientY - dragStartY;
        updateZoom();
      });
      const endDrag = (event) => {
        if (!dragging) return;

        dragging = false;
        stage.classList.remove("is-dragging");
        if (stage.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId);
      };
      stage.addEventListener("pointerup", endDrag);
      stage.addEventListener("pointercancel", endDrag);
      dialog.addEventListener("close", resetZoom);
      document.body.append(dialog);
      return dialog;
    };

    const openViewer = (source) => {
      const dialog = getViewer();
      const image = dialog.querySelector("img");
      image.src = source.currentSrc || source.src;
      image.alt = source.alt;
      dialog.querySelector(".docs-image-viewer-label").textContent = source.alt || "Documentation image";
      dialog.showModal();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bindImages, { once: true });
    } else {
      bindImages();
    }
    document.addEventListener("astro:page-load", bindImages);
  })();
</script>
<script is:inline>
  (() => {
    const initializeWalkthroughVideos = () => {
      document.querySelectorAll('video.docs-walkthrough-video').forEach((video) => {
        video.load();
        const playback = video.play();
        if (playback) playback.catch(() => {});
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeWalkthroughVideos, { once: true });
    } else {
      initializeWalkthroughVideos();
    }
    document.addEventListener('astro:page-load', initializeWalkthroughVideos);
  })();
</script>
<script is:inline>
  (() => {
    if (window.__sylvePageActionsDelegation) return;
    window.__sylvePageActionsDelegation = true;

    const closeDropdowns = () => {
      document
        .querySelectorAll('.dropdown > #dropdown-menu.show')
        .forEach((menu) => menu.classList.remove('show'));
    };

    const copyMarkdown = async (button) => {
      let resultClass = 'copied';

      try {
        button.disabled = true;

        const currentPath = button.dataset.path;
        if (!currentPath) throw new Error('Missing Markdown page path.');

        const response = await fetch(`${currentPath}.md`);
        if (!response.ok) {
          throw new Error(`Unable to load Markdown (${response.status}).`);
        }

        await navigator.clipboard.writeText(await response.text());
      } catch (error) {
        console.error(error);
        resultClass = 'error';
      } finally {
        button.classList.add(resultClass);
        button.disabled = false;

        window.setTimeout(() => {
          button.classList.remove(resultClass);
        }, 3000);
      }
    };

    // The plugin binds directly to the first page's elements. Delegating from
    // `document` keeps the controls functional after Astro swaps the page DOM.
    document.addEventListener(
      'click',
      (event) => {
        if (!(event.target instanceof Element)) return;

        const copyButton = event.target.closest('[data-page-action="copy-markdown"]');
        if (copyButton instanceof HTMLButtonElement) {
          event.preventDefault();
          event.stopPropagation();
          void copyMarkdown(copyButton);
          return;
        }

        const dropdownToggle = event.target.closest('.dropdown > #dropdown-toggle');
        if (dropdownToggle instanceof HTMLButtonElement) {
          event.preventDefault();
          event.stopPropagation();

          const dropdown = dropdownToggle.closest('.dropdown');
          const menu = dropdown?.querySelector(':scope > #dropdown-menu');
          const shouldOpen = menu && !menu.classList.contains('show');

          closeDropdowns();
          if (shouldOpen) menu.classList.add('show');
          return;
        }

        const dropdownMenu = event.target.closest('.dropdown > #dropdown-menu');
        if (dropdownMenu) {
          dropdownMenu.classList.remove('show');
          return;
        }

        closeDropdowns();
      },
      { capture: true },
    );
  })();
</script>
<ClientRouter />
<DefaultHead />

<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Sylve" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
