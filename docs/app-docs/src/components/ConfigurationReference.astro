  tbody td:last-child { border-right:0; color:var(--sl-color-gray-2); line-height:1.5; }
  tbody th { color:var(--sl-color-white); font-weight:500; }
  tbody tr:last-child > * { border-bottom:0; }
  code { padding:.08rem .28rem; border:1px solid var(--line); border-radius:.2rem; background:color-mix(in oklab,var(--sl-color-white) 4%,transparent); color:var(--sl-color-white); font:.64rem var(--sl-font-mono); white-space:nowrap; }
  .group th { padding:.62rem .9rem; border-right:0; background:color-mix(in oklab,var(--sl-color-white) 4%,transparent); }
  .group:not(:first-child) th { border-top:1px solid var(--line-strong); }
  .group span { margin-left:.65rem; color:var(--sl-color-gray-3); font-size:.65rem; font-weight:400; }
  .child { position:relative; display:inline-block; padding-left:1.15rem; font-family:var(--sl-font-mono); font-size:.65rem; }
  .child::before { position:absolute; top:-.75rem; bottom:-.75rem; left:.28rem; width:.55rem; border-bottom:1px solid var(--line-strong); border-left:1px solid var(--line-strong); content:""; }
  td:nth-child(2) { color:var(--sl-color-gray-2); }
  @media (max-width:40rem) { .table-wrap { margin-inline:-.5rem; } }
</style>
