---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
const featuredPost = sortedPosts.find(({ data }) => data.featured) ?? sortedPosts[0];
const remainingPosts = featuredPost
  ? sortedPosts.filter(({ id }) => id !== featuredPost.id)
  : [];
const isSinglePost = sortedPosts.length === 1;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric" }).format(date);
---

<BaseLayout
  title="Sylve Journal | Engineering notes"
  description="Product updates, technical decisions, and practical FreeBSD notes from the Sylve project."
>
  <div class:list={[
    "blog-index site-shell",
    !featuredPost && "blog-index-empty",
    isSinglePost && "blog-index-single",
  ]}>
    <header class:list={["blog-index-header", !featuredPost && "blog-index-header-empty"]}>
      <div class="blog-index-copy">
        <p class="section-kicker">Sylve journal</p>
        <h1>Notes from building Sylve.</h1>
        {!featuredPost && (
          <>
            <p class="blog-index-summary">
              Product updates, technical decisions, and practical FreeBSD notes
              from the Sylve project.
            </p>
            <div class="blog-empty-footer">
              <span class="journal-status">Publishing soon</span>
              <div class="blog-empty-actions">
                <a href="/docs/" class="button button-primary" data-astro-reload>Explore the documentation</a>
                <a href="https://github.com/AlchemillaHQ/Sylve" class="button button-secondary">
                  Follow on GitHub <span class="icon-[mdi--github] size-4" aria-hidden="true"></span>
                </a>
              </div>
            </div>
          </>
        )}
      </div>
      {!featuredPost && (
        <div class="journal-visual" aria-hidden="true">
          <span class="journal-visual-label">Sylve / Journal</span>
          <span class="journal-visual-index">Index / 01</span>
          <svg viewBox="0 0 480 320" role="presentation">
            <g class="journal-grid-lines">
              <path d="M38 58H442M38 112H442M38 166H442M38 220H442M38 274H442"></path>
              <path d="M78 34V294M159 34V294M240 34V294M321 34V294M402 34V294"></path>
            </g>
            <g class="journal-orbits">
              <circle cx="240" cy="164" r="112"></circle>
              <circle cx="240" cy="164" r="78"></circle>
              <path d="M128 164A112 112 0 0 1 340 113"></path>
              <path d="M240 86A78 78 0 0 1 301 212"></path>
            </g>
            <g class="journal-axis">
              <path d="M104 246L240 86L376 246Z"></path>
              <path d="M104 246H376M240 86V246"></path>
            </g>
            <g class="journal-points">
              <circle cx="240" cy="86" r="6"></circle>
              <circle cx="104" cy="246" r="6"></circle>
              <circle cx="376" cy="246" r="6"></circle>
              <circle cx="240" cy="164" r="11"></circle>
            </g>
            <text class="journal-figure-number" x="240" y="173" text-anchor="middle">01</text>
            <g class="journal-diagram-labels">
              <text x="256" y="78">FREEBSD</text>
              <text x="48" y="260">SYSTEMS</text>
              <text x="388" y="260">NOTES</text>
            </g>
          </svg>
        </div>
      )}
      {featuredPost && (
        <p>
          Product updates, technical decisions, and practical FreeBSD notes
          from the Sylve project.
        </p>
      )}
    </header>

    {featuredPost ? (
      <>
        <a
          href={`/blog/${featuredPost.id}`}
          class:list={["featured-post", isSinglePost && "featured-post-single"]}
        >
          <div class="post-art" data-category={featuredPost.data.category}>
            {featuredPost.data.image ? (
              <img src={featuredPost.data.image} alt="" />
            ) : (
              <div class="post-art-system" aria-hidden="true">
                <span>SYLVE / JOURNAL</span>
                <i></i><i></i><i></i><i></i>
                <strong>{featuredPost.data.category}</strong>
              </div>
            )}
          </div>
          <article>
            <div class="post-meta">
              <span>{featuredPost.data.category}</span>
              <time datetime={featuredPost.data.pubDate.toISOString()}>{formatDate(featuredPost.data.pubDate)}</time>
            </div>
            <h2>{featuredPost.data.title}</h2>
            <p>{featuredPost.data.description}</p>
            <div class="post-byline">
              <span>{featuredPost.data.author}</span>
              <span>Read article ↗</span>
            </div>
          </article>
        </a>

        {isSinglePost && (
          <section class="blog-index-cta" aria-labelledby="blog-cta-title">
            <div>
              <p class="section-kicker">Try Sylve</p>
              <h2 id="blog-cta-title">See the system for yourself.</h2>
              <p>Explore a working cluster in your browser, read the documentation, or help support continued development.</p>
            </div>
            <div class="blog-index-cta-actions">
              <a href="https://demo.sylve.io" class="button button-primary" target="_blank" rel="noopener noreferrer">
                <span class="icon-[lucide--monitor-play] size-4" aria-hidden="true"></span>
                Open demo
              </a>
              <a href="/docs/" class="button button-secondary" data-astro-reload>
                <span class="icon-[lucide--book-open] size-4" aria-hidden="true"></span>
                Read the docs
              </a>
              <button type="button" class="button button-secondary" data-sponsor-open>
                <span class="icon-[lucide--heart-handshake] size-4" aria-hidden="true"></span>
                Sponsor Sylve
              </button>
            </div>
          </section>
        )}

        {remainingPosts.length > 0 && (
          <section class="post-archive" aria-labelledby="archive-title">
            <div class="archive-heading">
              <h2 id="archive-title">All entries</h2>
              <span>{String(sortedPosts.length).padStart(2, "0")} published</span>
            </div>
            <div class="archive-list">
              {remainingPosts.map((post) => (
                <a href={`/blog/${post.id}`}>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <div>
                    <span>{post.data.category}</span>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                  </div>
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    ) : null}
  </div>
</BaseLayout>
