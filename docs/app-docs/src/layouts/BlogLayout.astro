---
import BaseLayout from "./BaseLayout.astro";
import BlogStructuredData from "@/components/BlogStructuredData.astro";

const { frontmatter } = Astro.props;
const slug = Astro.url.pathname.replace(/^\/blog\//, "").replace(/\/$/, "");
const published = new Date(frontmatter.pubDate);
const socialImage = frontmatter.ogImage ?? frontmatter.image;
---

<BaseLayout
  title={`${frontmatter.title} — Sylve Journal`}
  description={frontmatter.description}
  image={socialImage}
  ogType="article"
>
  <BlogStructuredData
    title={frontmatter.title}
    description={frontmatter.description}
    author={frontmatter.author}
    pubDate={published}
    slug={slug}
    image={socialImage}
  />

  <div class="blog-article site-shell">
    <a href="/blog" class="article-back">← Journal</a>

    <header class="article-header">
      <div class="article-heading">
        <p class="section-kicker">{frontmatter.category ?? "Engineering"}</p>
        <h1>{frontmatter.displayTitle ?? frontmatter.title}</h1>
        <p>{frontmatter.description}</p>
      </div>
      <dl class="article-meta">
        <div><dt>Published</dt><dd><time datetime={published.toISOString()}>{published.toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" })}</time></dd></div>
        <div><dt>Written by</dt><dd>{frontmatter.author}</dd></div>
        <div><dt>Filed under</dt><dd>{frontmatter.category ?? "Engineering"}</dd></div>
      </dl>
    </header>

    {frontmatter.image && !frontmatter.hideCover && (
      <div class="article-cover"><img src={frontmatter.image} alt="" /></div>
    )}

    <div class="article-layout">
      <article class="blog-content">
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>
