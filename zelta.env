# zelta.env
#
# This file sets global defaults for Zelta commands. It uses Bourne shell
# syntax: KEY=value. For policy jobs, use zelta.conf instead.
#
# Inside this file, the ZELTA_ prefix is optional. Outside this file, such as
# in a shell, cron, or script, use the ZELTA_ prefix: export ZELTA_LOG_LEVEL=4.
#
# For complete option documentation, run "zelta help options" or see
# zelta-options(7).
#
# IMPORTANT: ZELTA_AWK, ZELTA_ETC, ZELTA_ENV, ZELTA_CONFIG, and ZELTA_SHARE
# must be set before zelta.env can be loaded if you need non-default paths.

# # Set these in your environment before running zelta if needed:
# # export ZELTA_AWK="mawk"
# # export ZELTA_ETC="$HOME/.config/zelta"
# # export ZELTA_ENV="$HOME/.config/zelta/zelta.env"
# # export ZELTA_CONFIG="$HOME/.config/zelta/zelta.conf"
# # export ZELTA_SHARE="$HOME/.local/share/zelta"

# For logging purposes, zelta also looks for $USER and attempts to identify
# the hostname with $HOST or $HOSTNAME.


### Remote Command
# # Change SSH behavior. Usually SSH host, port, key, and jump-host settings
# # belong in the backup user's ~/.ssh/config instead.
# REMOTE_COMMAND="ssh"
# REMOTE_DEFAULT="ssh -n"
# REMOTE_SEND="ssh -n"
# REMOTE_RECV="ssh"


### SNAPSHOT NAMES
##################
#
# # Use the following variable to override the snapshot name.
# # By default, we use "zelta_YYYY-MM-DD_HH.MM.SS".
#
# IMPORTANT: To use dynamic names from a command, quote the command
# substitution so it is evaluated by Zelta at runtime.
#
# # zfsnap style:
# SNAP_NAME='$(date -u +%Y-%m-%d_%H.%M.%S--1m)'
#
# # TrueNAS auto style:
# SNAP_NAME='$(date -u +auto-%Y-%m-%d_%H-%M)'
#
# # Sanoid autosnap style:
# SNAP_NAME='$(date -u +autosnap_%Y-%m-%d_%H:%M:%S_daily)'
#
# # Prefix the default or generated snapshot name:
# SNAP_PREFIX="$(whoami)_"


### ZFS SEND AND RECEIVE OPTIONS
################################
#
# # Options for unencrypted filesystems and volumes (--raw is equivalent to -Lce)
# SEND_DEFAULT="--raw"
#
# # Options for encrypted datasets when raw incremental send is unavailable
# SEND_DECRYPTED="-L -c"
#
# # Options for encrypted datasets
# SEND_RAW="--raw"
#
# # Additional options for new datasets
# SEND_NEW="-p"
#
# # Toggle intermediate snapshots (1=yes, 0=no)
# SEND_INTR="1"
#
# # Options for replicate mode
# SEND_REPLICATE="--raw -s -R"
#
# # Default receive options
# RECV_DEFAULT=""
#
# # Options for top dataset on new backup
# RECV_TOP="-o readonly=on"
#
# # Options for filesystems on new backup
# RECV_FS="-u -x mountpoint -o canmount=noauto"
#
# # Options for volumes on new backup
# RECV_VOL=""
#
# # Options for partial receives
# RECV_PARTIAL="-s"
#
# # Options for `zelta clone`
# CLONE_DEFAULT="-po readonly=off"


### LOGGING OPTIONS
##################
#
# # Control verbosity and output format for notices, warnings, etc.
# # LOG_LEVEL values: 0 errors, 1 warnings, 2 notices, 3 info, 4 debug.
# LOG_LEVEL="2"
#
# # Output mode: 'text' (default) or 'json' (for structured logs, e.g., in scripts)
# LOG_MODE="text"
#
# # Divert all output to a file (useful for cron jobs or long runs)
# LOG_FILE="/var/log/zelta.log"


### REPORT OUTPUT
#################
#
# # `zelta report` messages and optional commands can use these symbols:
# # {message}, {endpoint}, {host}, {dataset}, {dslist}, {oldcount}, {okcount}, {status}
# # Commands are run by the shell after Zelta substitutes these report symbols.
# REPORT_MESSAGE_NONE="{endpoint} no snapshots found"
# REPORT_MESSAGE_ALL="{endpoint} all snapshots are out of date"
# REPORT_MESSAGE_SOME="{endpoint} some snapshots are out of date: {dslist}"
# REPORT_MESSAGE_OK="{endpoint} snapshots are up to date"
# REPORT_COMMAND_DEFAULT=""
# REPORT_COMMAND_NONE=""
# REPORT_COMMAND_ALL=""
# REPORT_COMMAND_SOME=""
# REPORT_COMMAND_OK=""
#
# # Example Slack webhook command. Define SLACK_HOOK outside this file or inline here.
# REPORT_COMMAND_DEFAULT='curl -s -X POST -H "Content-type: application/json; charset=utf-8" --data "{ \"username\": \"zeport\", \"icon_emoji\": \":camera_with_flash:\", \"text\": \"{message}\" }" "$SLACK_HOOK"'


### REMOTE/SSH OPTIONS
######################
#
# # SSH command for general operations (must support -n to avoid stdin issues)
# REMOTE_COMMAND="ssh"
#
# # Default SSH for misc ops (prevents stdin reading)
# REMOTE_DEFAULT="ssh -n"
#
# # SSH for 'zfs send' (may need tweaks for slow networks)
# REMOTE_SEND="ssh -n"
#
# # SSH for 'zfs recv' (can be customized for bandwidth limits)
# REMOTE_RECV="ssh"

### GENERAL REPLICATION AND SAFETY OPTIONS
###########################################
#
# # Snapshot mode: 'IF_NEEDED' (default, only if data changed), 'ALWAYS', 'SKIP', or '0' (off)
# SNAP_MODE="IF_NEEDED"
#
# # Sync direction for remote endpoints: 'PULL' (default) or 'PUSH'
# SYNC_DIRECTION="PULL"
#
# # Enable resume of interrupted transfers (default: on for safety)
# RESUME="1"
#
# # Auto-create parent datasets if missing (default: on)
# CREATE_PARENT="1"
#
# # Limit recursion depth (0 = unlimited, default)
# DEPTH="0"
#
# # Exclude patterns (comma-separated; see manpage for syntax)
# EXCLUDE="*/swap,@temp-*"

### MISCELLANEOUS UTILITY OPTIONS
#################################
#
# # Enable written size calculations in 'zelta match' (default: on)
# LIST_WRITTEN="1"
#
## # Use pv for progress and a 10m limit:
# RECEIVE_PREFIX="pv -ptr -L 10m"
