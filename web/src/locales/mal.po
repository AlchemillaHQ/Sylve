#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Move service cleanly to another node."
msgstr "സേവനം മറ്റൊരു നോഡിലേക്ക് വൃത്തിയായി മാറ്റുക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Current active node is demoted and data is synced before promotion."
msgstr "നിലവിലെ ആക്റ്റീവ് നോഡ് ഡീമോട്ട് ചെയ്യപ്പെടുകയും പ്രൊമോഷന് മുമ്പ് ഡാറ്റ സിങ്ക് ചെയ്യപ്പെടുകയും ചെയ്യുന്നു."

#: src/routes/datacenter/replication/policies/+page.svelte
#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Force recovery"
msgstr "നിർബന്ധിത വീണ്ടെടുക്കൽ"

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Recover quickly when current active node is unreachable."
msgstr "നിലവിലെ ആക്റ്റീവ് നോഡ് ലഭ്യമാകാത്തപ്പോൾ വേഗത്തിൽ വീണ്ടെടുക്കുക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "May lose the newest writes that never reached other nodes."
msgstr "മറ്റ് നോഡുകളിൽ എത്താത്ത പുതിയ വിവരങ്ങൾ നഷ്ടപ്പെട്ടേക്കാം."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Safe move is unavailable because the current active node appears down. Use Force recovery."
msgstr "നിലവിലെ ആക്റ്റീവ് നോഡ് പ്രവർത്തനരഹിതമായതിനാൽ സുരക്ഷിതമായ മാറ്റം സാധ്യമല്ല. നിർബന്ധിത വീണ്ടെടുക്കൽ ഉപയോഗിക്കുക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Force recovery requires data-loss acknowledgement before you can continue."
msgstr "തുടരുന്നതിന് മുമ്പ് ഡാറ്റ നഷ്ടപ്പെടുമെന്ന അംഗീകാരം നിർബന്ധിത വീണ്ടെടുക്കലിന് ആവശ്യമാണ്."

#. 0: FORCE_RECOVERY_CONFIRM_TEXT
#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Type {0} to confirm Force recovery."
msgstr "നിർബന്ധിത വീണ്ടെടുക്കൽ സ്ഥിരീകരിക്കാൻ {0} എന്ന് ടൈപ്പ് ചെയ്യുക."

#: src/routes/datacenter/replication/policies/+page.svelte
#: src/routes/datacenter/replication/policies/+page.svelte
#: src/routes/datacenter/replication/policies/+page.svelte
#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Replication HA requires at least 3 configured Raft voters."
msgstr "റെപ്ലിക്കേഷൻ HA-യ്ക്ക് കുറഞ്ഞത് 3 കോൺഫിഗർ ചെയ്ത റാഫ്റ്റ് വോട്ടർമാർ ആവശ്യമാണ്."

#: src/routes/datacenter/replication/policies/+page.svelte
#: src/routes/datacenter/replication/policies/+page.svelte
#: src/routes/datacenter/replication/policies/+page.svelte
msgid "At least one target must be different from the effective runner node."
msgstr "കുറഞ്ഞത് ഒരു ടാർഗെറ്റെങ്കിലും റണ്ണർ നോഡിൽ നിന്ന് വ്യത്യസ്തമായിരിക്കണം."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "This move would leave no remote target for replication; adjust targets first."
msgstr "ഈ മാറ്റം റെപ്ലിക്കേഷനായി റിമോട്ട് ടാർഗെറ്റുകൾ ഇല്ലാതാക്കും; ആദ്യം ടാർഗെറ്റുകൾ ക്രമീകരിക്കുക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Cluster quorum is unavailable. Bring quorum back before running this action."
msgstr "ക്ലസ്റ്റർ കോറം ലഭ്യമല്ല. ഈ പ്രവർത്തനം നടത്തുന്നതിന് മുമ്പ് കോറം തിരികെ കൊണ്ടുവരിക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "A move is already running for this policy. Wait for it to finish and try again."
msgstr "ഈ പോളിസിക്കായി ഒരു മാറ്റം ഇപ്പോൾ നടക്കുന്നുണ്ട്. അത് കഴിയുന്നതുവരെ കാത്തിരിക്കുക, എന്നിട്ട് വീണ്ടും ശ്രമിക്കുക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Safe move needs the current active node online. Use Force recovery only if the node is down."
msgstr "സുരക്ഷിതമായ മാറ്റത്തിന് നിലവിലെ ആക്റ്റീവ് നോഡ് ഓൺലൈനായിരിക്കണം. നോഡ് ഓഫ്‌ലൈനാണെങ്കിൽ മാത്രം നിർബന്ധിത വീണ്ടെടുക്കൽ ഉപയോഗിക്കുക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Force recovery needs data-loss confirmation before starting."
msgstr "ആരംഭിക്കുന്നതിന് മുമ്പ് ഡാറ്റ നഷ്ടം സ്ഥിരീകരിക്കേണ്ടതുണ്ട്."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "The selected target server is not in this policy's target list."
msgstr "തിരഞ്ഞെടുത്ത ടാർഗെറ്റ് സെർവർ ഈ പോളിസിയുടെ പട്ടികയിലില്ല."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "The selected target server is offline. Choose an online target."
msgstr "തിരഞ്ഞെടുത്ത ടാർഗെറ്റ് സെർവർ ഓഫ്‌ലൈനാണ്. ഒരു ഓൺലൈൻ ടാർഗെറ്റ് തിരഞ്ഞെടുക്കുക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "No healthy target server is available for this policy right now."
msgstr "ഈ പോളിസിക്കായി ഇപ്പോൾ ആരോഗ്യകരമായ ടാർഗെറ്റ് സെർവറുകളൊന്നുമില്ല."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "The target server must be different from the current active server."
msgstr "ടാർഗെറ്റ് സെർവർ നിലവിലെ ആക്റ്റീവ് സെർവറിൽ നിന്ന് വ്യത്യസ്തമായിരിക്കണം."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Force recovery requires cluster quorum. Bring enough nodes online and try again."
msgstr "നിർബന്ധിത വീണ്ടെടുക്കലിന് ക്ലസ്റ്റർ കോറം ആവശ്യമാണ്. ആവശ്യത്തിന് നോഡുകൾ ഓൺലൈനിൽ കൊണ്ടുവന്ന ശേഷം വീണ്ടും ശ്രമിക്കുക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "This node is no longer cluster leader. Retry in a few seconds."
msgstr "ഈ നോഡ് ഇപ്പോൾ ക്ലസ്റ്റർ ലീഡർ അല്ല. കുറച്ച് നിമിഷങ്ങൾക്ക് ശേഷം വീണ്ടും ശ്രമിക്കുക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Could not start failover. Check cluster status and try again."
msgstr "ഫെയ്‌ലോവർ ആരംഭിക്കാൻ കഴിഞ്ഞില്ല. ക്ലസ്റ്റർ നില പരിശോധിച്ച ശേഷം വീണ്ടും ശ്രമിക്കുക."

#: src/routes/datacenter/replication/policies/+page.svelte
#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Cluster quorum is unavailable. Retry after quorum is restored."
msgstr "ക്ലസ്റ്റർ കോറം ലഭ്യമല്ല. കോറം പുനഃസ്ഥാപിച്ച ശേഷം വീണ്ടും ശ്രമിക്കുക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Failed to update policy"
msgstr "പോളിസി അപ്ഡേറ്റ് ചെയ്യുന്നതിൽ പരാജയപ്പെട്ടു"

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Failed to create policy"
msgstr "പോളിസി സൃഷ്ടിക്കുന്നതിൽ പരാജയപ്പെട്ടു"

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "This policy needs at least one remote target from its effective runner node."
msgstr "ഈ പോളിസിക്ക് അതിന്റെ റണ്ണർ നോഡിൽ നിന്ന് കുറഞ്ഞത് ഒരു റിമോട്ട് ടാർഗെറ്റെങ്കിലും ആവശ്യമാണ്."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "This move would leave no remote target for replication."
msgstr "ഈ മാറ്റം റെപ്ലിക്കേഷനായി റിമോട്ട് ടാർഗെറ്റുകൾ ഇല്ലാതാക്കും."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Cluster quorum is unavailable."
msgstr "ക്ലസ്റ്റർ കോറം ലഭ്യമല്ല."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "This policy is currently blocked by HA constraints."
msgstr "ഈ പോളിസി നിലവിൽ HA നിയന്ത്രണങ്ങളാൽ തടയപ്പെട്ടിരിക്കുകയാണ്."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Stay with whichever node is currently active"
msgstr "നിലവിൽ ആക്റ്റീവ് ആയ നോഡിൽ തന്നെ തുടരുക"

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "After any move, this new active node becomes the new source."
msgstr "ഏതെങ്കിലും മാറ്റത്തിന് ശേഷം, ഈ പുതിയ ആക്റ്റീവ് നോഡ് പുതിയ സോഴ്‌സ് ആയി മാറും."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Keep one preferred primary node"
msgstr "ഒരു മുൻഗണനാ പ്രൈമറി നോഡ് നിലനിർത്തുക"

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Use one fixed primary node as the source until you change it."
msgstr "നിങ്ങൾ മാറ്റുന്നത് വരെ ഒരു നിശ്ചിത പ്രൈമറി നോഡ് സോഴ്‌സ് ആയി ഉപയോഗിക്കുക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Manual only"
msgstr "മാനുവൽ മാത്രം"

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "No automatic move when the active node goes down."
msgstr "ആക്റ്റീവ് നോഡ് പ്രവർത്തനരഹിതമാകുമ്പോൾ ഓട്ടോമാറ്റിക് മാറ്റമുണ്ടാകില്ല."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "An admin chooses when and where to move the workload."
msgstr "ജോലി എപ്പോൾ, എവിടേക്ക് മാറ്റണമെന്ന് ഒരു അഡ്മിൻ തീരുമാനിക്കുന്നു."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Automatic force recovery"
msgstr "ഓട്ടോമാറ്റിക് ഫോഴ്സ് റിക്കവറി"

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Automatically recover even when clean handoff is impossible."
msgstr "ക്ലീൻ ഹാൻഡ്‌ഓഫ് അസാധ്യമാകുമ്പോഴും ഓട്ടോമാറ്റിക്കായി വീണ്ടെടുക്കുക."

#: src/routes/datacenter/replication/policies/+page.svelte
msgid "Fastest recovery, but newest writes may be lost."
msgstr "ഏറ്റവും വേഗതയേറിയ വീണ്ടെടുക്കൽ, എന്നാൽ പുതിയ വിവരങ്ങൾ നഷ്ടപ്പെട്ടേക്കാം."

